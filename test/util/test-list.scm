(test-begin "list-head")
(setup)
(test-equal '()
            (list-head lst 0))
(test-equal '(1)
            (list-head lst 1))
(test-equal '(1 "2")
            (list-head lst 2))
(test-equal '(1 "2" three)
            (list-head lst 3))
(test-equal '(1 "2" three (4) 5 six "7" (8 8))
            (list-head lst 8))
(test-equal '(1 "2" three (4) 5 six "7" (8 8) -9)
            (list-head lst 9))
(test-error (list-head lst 10))
(test-error (list-head lst -1))
(test-end)

(test-begin "alist-replace")
(setup)
(define alist '())
(set! alist (alist-replace '(first 1 "1") alist))
(test-equal '((first 1 "1"))
            alist)
(set! alist (alist-replace '(second 2 "2") alist))
(test-equal '((second 2 "2") (first 1 "1"))
            alist)
(set! alist (alist-replace '(third 3 "3") alist))
(test-equal '((third 3 "3") (second 2 "2") (first 1 "1"))
            alist)
(set! alist (alist-replace '(second two "two") alist))
(test-equal '((third 3 "3") (second two "two") (first 1 "1"))
            alist)
(test-end)

(test-begin "list-join")
(setup)
(test-equal '()
            (list-join () ()))
(test-equal '(())
            (list-join '(()) ()))
(test-equal '(1)
            (list-join '(1) ()))
(test-equal '(() () ())
            (list-join '(() ()) ()))
(test-equal '(1 () 2)
            (list-join '(1 2) ()))
(test-equal '(1 () 2 () 3)
            (list-join '(1 2 3) ()))
(test-equal '(one () two () three)
            (list-join '(one two three) ()))
(test-equal '("1" () "2" () "3")
            (list-join '("1" "2" "3") ()))
(test-equal '(() () () () ())
            (list-join '(() () ()) ()))
(test-equal '()
            (list-join () "/"))
(test-equal '(())
            (list-join '(()) "/"))
(test-equal '(1)
            (list-join '(1) "/"))
(test-equal '(() "/" ())
            (list-join '(() ()) "/"))
(test-equal '(1 "/" 2)
            (list-join '(1 2) "/"))
(test-equal '(1 "/" 2 "/" 3)
            (list-join '(1 2 3) "/"))
(test-equal '(one "/" two "/" three)
            (list-join '(one two three) "/"))
(test-equal '("1" "/" "2" "/" "3")
            (list-join '("1" "2" "3") "/"))
(test-equal '(() "/" () "/" ())
            (list-join '(() () ()) "/"))
(test-end)

(test-begin "nthcdr")
(setup)
(set! lst '(1 2 3 4))
(test-equal '(1 2 3 4)
            (nthcdr 0 lst))
(test-equal '(2 3 4)
            (nthcdr 1 lst))
(test-equal '(3 4)
            (nthcdr 2 lst))
(test-equal '(4)
            (nthcdr 3 lst))
(test-equal '()
            (nthcdr 4 lst))
(test-equal #f
            (nthcdr 5 lst))
(test-end)

(test-report-result)
