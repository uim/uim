(require-extension (unittest))

(define lst #f)

(define (setup)
  (set! lst '(1 "2" three (4) 5 six "7" (8 8) -9)))

(test-begin "truncate-list")
(setup)
(test-equal '()
            (truncate-list () 0))
(test-false (truncate-list () 1))
(test-equal '()
            (truncate-list '("foo" "bar" "baz") 0))
(test-equal '("foo")
            (truncate-list '("foo" "bar" "baz") 1))
(test-equal '("foo" "bar")
            (truncate-list '("foo" "bar" "baz") 2))
(test-equal '("foo" "bar" "baz")
            (truncate-list '("foo" "bar" "baz") 3))
(test-false (truncate-list '("foo" "bar" "baz") 4))
(test-end)

(test-begin "proc-or")
(setup)
(test-false (proc-or))
(test-false (proc-or #f))
(test-eq #t (proc-or #t))
(test-false (proc-or #f #f))
(test-eq #t (proc-or #f #t))
(test-eq #t (proc-or #t #f))
(test-eq #t (proc-or #t #t))
(test-false (proc-or #f #f #f))
(test-eq #t (proc-or #f #f #t))
(test-eq #t (proc-or #f #t #f))
(test-eq #t (proc-or #f #t #t))
(test-eq #t (proc-or #t #f #f))
(test-eq #t (proc-or #t #f #t))
(test-eq #t (proc-or #t #t #f))
(test-eq #t (proc-or #t #t #t))
(test-false (apply proc-or ()))
(test-false (apply proc-or '(#f)))
(test-eq #t (apply proc-or '(#t)))
(test-false (apply proc-or '(#f #f)))
(test-eq #t (apply proc-or '(#f #t)))
(test-eq #t (apply proc-or '(#t #f)))
(test-eq #t (apply proc-or '(#t #t)))
(test-false (apply proc-or '(#f #f #f)))
(test-eq #t (apply proc-or '(#f #f #t)))
(test-eq #t (apply proc-or '(#f #t #f)))
(test-eq #t (apply proc-or '(#f #t #t)))
(test-eq #t (apply proc-or '(#t #f #f)))
(test-eq #t (apply proc-or '(#t #f #t)))
(test-eq #t (apply proc-or '(#t #t #f)))
(test-eq #t (apply proc-or '(#t #t #t)))
(test-end)

(test-begin "proc-and")
(setup)
(test-eq #t (proc-and))
(test-false (proc-and #f))
(test-eq #t (proc-and #t))
(test-false (proc-and #f #f))
(test-false (proc-and #f #t))
(test-false (proc-and #t #f))
(test-eq #t (proc-and #t #t))
(test-false (proc-and #f #f #f))
(test-false (proc-and #f #f #t))
(test-false (proc-and #f #t #f))
(test-false (proc-and #f #t #t))
(test-false (proc-and #t #f #f))
(test-false (proc-and #t #f #t))
(test-false (proc-and #t #t #f))
(test-eq #t (proc-and #t #t #t))
(test-eq #t (apply proc-and ()))
(test-false (apply proc-and '(#f)))
(test-eq #t (apply proc-and '(#t)))
(test-false (apply proc-and '(#f #f)))
(test-false (apply proc-and '(#f #t)))
(test-false (apply proc-and '(#t #f)))
(test-eq #t (apply proc-and '(#t #t)))
(test-false (apply proc-and '(#f #f #f)))
(test-false (apply proc-and '(#f #f #t)))
(test-false (apply proc-and '(#f #t #f)))
(test-false (apply proc-and '(#f #t #t)))
(test-false (apply proc-and '(#t #f #f)))
(test-false (apply proc-and '(#t #f #t)))
(test-false (apply proc-and '(#t #t #f)))
(test-eq #t (apply proc-and '(#t #t #t)))
(test-end)

;; See "Specification changes of utility procedures" of doc/COMPATIBILITY
(test-begin "sublist-uim-1.5")
(setup)
;; 0
(test-equal '()
            (sublist lst 0 0))
(test-equal '(1)
            (sublist lst 0 1))
(test-equal '(1 "2")
            (sublist lst 0 2))
(test-equal '(1 "2" three)
            (sublist lst 0 3))
(test-equal '(1 "2" three (4))
            (sublist lst 0 4))
(test-equal '(1 "2" three (4) 5 six "7")
            (sublist lst 0 7))
(test-equal '(1 "2" three (4) 5 six "7" (8 8))
            (sublist lst 0 8))
(test-equal '(1 "2" three (4) 5 six "7" (8 8) -9)
            (sublist lst 0 9))
(test-error (sublist lst 0 10))
;; 1
(test-error (sublist lst 1 0))
(test-equal '()
            (sublist lst 1 1))
(test-equal '("2")
            (sublist lst 1 2))
(test-equal '("2" three)
            (sublist lst 1 3))
(test-equal '("2" three (4))
            (sublist lst 1 4))
(test-equal '("2" three (4) 5 six "7")
            (sublist lst 1 7))
(test-equal '("2" three (4) 5 six "7" (8 8))
            (sublist lst 1 8))
(test-equal '("2" three (4) 5 six "7" (8 8) -9)
            (sublist lst 1 9))
(test-error (sublist lst 1 10))
;; 2
(test-error (sublist lst 2 0))
(test-error (sublist lst 2 1))
(test-equal '()
            (sublist lst 2 2))
(test-equal '(three)
            (sublist lst 2 3))
(test-equal '(three (4))
            (sublist lst 2 4))
(test-equal '(three (4) 5 six "7")
            (sublist lst 2 7))
(test-equal '(three (4) 5 six "7" (8 8))
            (sublist lst 2 8))
(test-equal '(three (4) 5 six "7" (8 8) -9)
            (sublist lst 2 9))
(test-error (sublist lst 2 10))
;; 3
(test-error (sublist lst 3 0))
(test-error (sublist lst 3 1))
(test-error (sublist lst 3 2))
(test-equal '()
            (sublist lst 3 3))
(test-equal '((4))
            (sublist lst 3 4))
(test-equal '((4) 5)
            (sublist lst 3 5))
(test-equal '((4) 5 six "7" (8 8))
            (sublist lst 3 8))
(test-equal '((4) 5 six "7" (8 8) -9)
            (sublist lst 3 9))
(test-error (sublist lst 3 10))
;; 8
(test-error (sublist lst 8 0))
(test-error (sublist lst 8 1))
(test-error (sublist lst 8 2))
(test-error (sublist lst 8 3))
(test-error (sublist lst 8 4))
(test-error (sublist lst 8 7))
(test-equal '()
            (sublist lst 8 8))
(test-equal '(-9)
            (sublist lst 8 9))
(test-error (sublist lst 8 10))
;; 9
(test-error (sublist lst 9 0))
(test-error (sublist lst 9 1))
(test-error (sublist lst 9 2))
(test-error (sublist lst 9 3))
(test-error (sublist lst 9 4))
(test-error (sublist lst 9 7))
(test-error (sublist lst 9 8))
(test-equal '()
            (sublist lst 9 9))
(test-error (sublist lst 9 10))
(test-end)

