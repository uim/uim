# The SVG and PNG files that aren't in Git are generated by
# Autotools' maintainer mode, and source archives include them. Here
# copies are installed with rename:, and PNG files are generated by
# rsvg-convert only when they don't exist.

svgs = files(
  'unknown.svg',
  'unknown_dark_background.svg',
  'direct.svg',
  'skk.svg',
  'tcode.svg',
  'tutcode.svg',
  'byeoru.svg',
  'direct_dark_background.svg',
  'skk_dark_background.svg',
  'tcode_dark_background.svg',
  'tutcode_dark_background.svg',
  'direct_input.svg',
  'on.svg',
  'off.svg',
  'ja_direct.svg',
  'ja_hiragana.svg',
  'ja_katakana.svg',
  'ja_halfkana.svg',
  'ja_halfwidth_alnum.svg',
  'ja_fullwidth_alnum.svg',
  'ko_direct.svg',
  'ko_hangulchar.svg',
  'ko_hangulword.svg',
  'direct_input_dark_background.svg',
  'on_dark_background.svg',
  'off_dark_background.svg',
  'ja_direct_dark_background.svg',
  'ja_hiragana_dark_background.svg',
  'ja_katakana_dark_background.svg',
  'ja_halfkana_dark_background.svg',
  'ja_halfwidth_alnum_dark_background.svg',
  'ja_fullwidth_alnum_dark_background.svg',
  'ko_direct_dark_background.svg',
  'ko_hangulchar_dark_background.svg',
  'ko_hangulword_dark_background.svg',
  'ja_romaji.svg',
  'ja_kana.svg',
  'ja_azik.svg',
  'ja_act.svg',
  'ja_kzik.svg',
  'ja_nicola.svg',
  'ja_pocketbell.svg',
  'ja_romaji_dark_background.svg',
  'ja_kana_dark_background.svg',
  'ja_azik_dark_background.svg',
  'ja_act_dark_background.svg',
  'ja_kzik_dark_background.svg',
  'im_switcher.svg',
  'uim-dict.svg',
  'uim-icon.svg',
  'im_subst.svg',
)
install_data(svgs, install_dir: uim_pixmapsdir)

install_data(
  'null.png',
  'uim-icon64.png',
  'uim-icon48.png',
  'uim-gray.png',
  install_dir: uim_pixmapsdir)

# Input methods without their own icons.
im_subst_names = [
  'py',
  'pyunihan',
  'pinyin-big5',
  'hangul2',
  'hangul3',
  'romaja',
  'viqr',
  'ipa-x-sampa',
  'latin',
  'elatin',
  'look',
  'scim',
  'wnn',
  'google-cgiapi-jp',
  'baidu-olime-jp',
]
# [copy, original]
copies = [
  ['trycode.svg', 'tcode.svg'],
  ['trycode_dark_background.svg', 'tcode_dark_background.svg'],
  ['anthy.png', 'scim-anthy.png'],
  ['canna.png', 'scim-canna.png'],
  ['uim-icon.png', 'uim-icon48.png'],
]
foreach name : im_subst_names
  copies += [[name + '.svg', 'im_subst.svg']]
endforeach
foreach copy : copies
  install_data(copy[1], install_dir: uim_pixmapsdir, rename: copy[0])
endforeach

# [PNG, SVG]
svg_pngs = [
  ['trycode.png', 'tcode.svg'],
  ['trycode_dark_background.png', 'tcode_dark_background.svg'],
]
foreach name : im_subst_names
  svg_pngs += [[name + '.png', 'im_subst.svg']]
endforeach
foreach png : [
  'unknown.png',
  'direct.png',
  'skk.png',
  'tcode.png',
  'tutcode.png',
  'byeoru.png',
  'direct_input.png',
  'on.png',
  'off.png',
  'ja_direct.png',
  'ja_hiragana.png',
  'ja_katakana.png',
  'ja_halfkana.png',
  'ja_halfwidth_alnum.png',
  'ja_fullwidth_alnum.png',
  'ko_direct.png',
  'ko_hangulchar.png',
  'ko_hangulword.png',
  'ja_romaji.png',
  'ja_kana.png',
  'ja_azik.png',
  'ja_act.png',
  'ja_kzik.png',
  'ja_nicola.png',
  'ja_pocketbell.png',
  'im_switcher.png',
  'uim-dict.png',
  'unknown_dark_background.png',
  'direct_dark_background.png',
  'skk_dark_background.png',
  'tcode_dark_background.png',
  'tutcode_dark_background.png',
  'direct_input_dark_background.png',
  'on_dark_background.png',
  'off_dark_background.png',
  'ja_direct_dark_background.png',
  'ja_hiragana_dark_background.png',
  'ja_katakana_dark_background.png',
  'ja_halfkana_dark_background.png',
  'ja_halfwidth_alnum_dark_background.png',
  'ja_fullwidth_alnum_dark_background.png',
  'ko_direct_dark_background.png',
  'ko_hangulchar_dark_background.png',
  'ko_hangulword_dark_background.png',
  'ja_romaji_dark_background.png',
  'ja_kana_dark_background.png',
  'ja_azik_dark_background.png',
  'ja_act_dark_background.png',
  'ja_kzik_dark_background.png',
]
  svg_pngs += [[png, png.replace('.png', '.svg')]]
endforeach
rsvg_convert = find_program('rsvg-convert',
                            required: not fs.exists(svg_pngs[0][0]))
foreach svg_png : svg_pngs
  if fs.exists(svg_png[0])
    install_data(svg_png[0], install_dir: uim_pixmapsdir)
  else
    custom_target(svg_png[0],
                  command: [
                    rsvg_convert,
                    '-w', '48',
                    '-h', '48',
                    '-f', 'png',
                    '@INPUT@',
                    '-o', '@OUTPUT@',
                  ],
                  input: svg_png[1],
                  install: true,
                  install_dir: uim_pixmapsdir,
                  output: svg_png[0])
  endif
endforeach
