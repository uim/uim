;;; TUT-Codeの記号入力時の記号・漢字の選択を、
;;; 百相鍵盤『き』と同様、2打鍵で行うためのコード表。
;;; 基本的には文字コード順。
;;;
;;; キーアサインツール「天狼」に含まれる、
;;; 百相鍵盤『き』用の配列ファイル(ki.js)の形式を変換したもの。
;;; http://www.sirius.spline.tv/
;;;
;;; 一部キーを変更:
;;;  - _ -> \
;;;  - Shift + _ -> _
;;;  - Shift + Space -> Space
;;;  - Shift + 0 -> |

;;; キーの位置ではなく、内容に基づくruleを変換する。
;;; (dvorakキーボードでも、同じ位置のキーで同じ漢字が入力されるように、
;;;  ruleの変換をtutcode-kigou-rule-translateで行うが、
;;;  そうするとキー内容に基づくruleがキーと合わなくなるので、
;;;  (例: ((("q" " "))("ｑ")) → ((("'" " "))("ｑ")))
;;;  内容に基づくruleはtutcode-kigou-rule-translateの前に変換しておく。
;;;  (例: ((("q" " "))("ｑ")) → ((("q" " "))("’")) → ((("'" " "))("’"))))
;;; @param translate-alist 変換表
;;; @return 変換したコード表
;;; XXX:kigou-ruleの内容に応じた変換が必要なので、
;;;     この関数はtutcode-kigou-rule.scmファイル内に記述。
(define (tutcode-kigou-rule-pre-translate translate-alist)
  (require "japanese.scm") ; for ja-wide
  (map
    (lambda (elem)
      (let*
        ((seq (caar elem))
         (key1 (car seq))
         (key2 (cadr seq))
         (tr (and (string=? key2 " ") (assoc key1 translate-alist)))
         (tr-key (and tr (cadr tr)))
         (tr-char (and tr-key (ja-wide tr-key))))
        (if tr-char
          (list (list seq) (list tr-char))
          elem)))
    tutcode-kigou-rule))

