install_data(scm_files, install_dir: pkgdatadir)

# The order is the preference order at the default input method
# selection for each language.
module_names = []
if anthy.found()
  module_names += ['anthy']
endif
if anthy_utf8.found()
  module_names += ['anthy-utf8']
endif
# Canna is used through cannaserver, so it needs no plugin.
if get_option('canna')
  module_names += ['canna']
endif
if get_option('skk')
  module_names += ['skk']
endif
module_names += [
  'tutcode',
  'byeoru',
  'latin',
  'elatin',
]
if m17nlib.found()
  module_names += ['m17nlib']
endif
module_names += [
  # less preferable IMs
  'pyload',
  'viqr',
  'ipa-x-sampa',
  'look',
  # web based IMs
  'google-cgiapi-jp',
  'baidu-olime-jp',
]
# uim-module-manager loads the modules to list their input methods, so
# it needs the plugins they use.
custom_target('installed-modules.scm',
              command: [
                programs['uim-module-manager'],
                '--path', '@OUTDIR@',
                '--register', module_names,
              ],
              depends: plugins,
              env: {
                'LIBUIM_PLUGIN_LIB_DIR': meson.project_build_root() / 'uim',
                'LIBUIM_SCM_FILES': meson.current_source_dir(),
                'LIBUIM_SYSTEM_SCM_FILES': (meson.project_source_root() /
                                            'subprojects' / 'sigscheme' / 'lib'),
                'UIM_DISABLE_NOTIFY': '1',
              },
              input: scm_files,
              install: true,
              install_dir: pkgdatadir,
              output: ['installed-modules.scm', 'loader.scm'])
